{
  "name": "rec-bot",
  "version": "1.0.0",
  "description": "Self-hosted Google Meet recording bot for ANCC lecture capture",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "rec-bot": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev:record": "tsx src/cli.ts record",
    "dev:serve": "tsx src/cli.ts serve",
    "dev:schedule": "tsx src/cli.ts schedule",
    "start": "node dist/cli.js",
    "record": "node dist/cli.js record",
    "serve": "node dist/cli.js serve",
    "schedule": "node dist/cli.js schedule",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "execa": "^9.5.2",
    "express": "^4.21.2",
    "googleapis": "^144.0.0",
    "pino": "^9.6.0",
    "playwright": "1.49.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.17.12",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
