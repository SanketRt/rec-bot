# ============================================================================
#  rec-bot configuration — copy to `.env` and edit.
#  Every value here has a sane default; uncomment only what you need to change.
# ============================================================================

# --- Display / capture quality ----------------------------------------------
# SCREEN_WIDTH=1920
# SCREEN_HEIGHT=1080
# FRAMERATE=30
# VIDEO_CRF=23           # lower = higher quality + bigger file (18 visually lossless, 28 small)
# VIDEO_PRESET=veryfast  # x264 speed/size tradeoff; "veryfast" is right for 2 vCPU
# AUDIO_BITRATE=192k

# --- Bot identity -----------------------------------------------------------
BOT_NAME=ANCC Recording
# CHROME_USER_DATA_DIR=/data/chrome-profile   # persistent Google login lives here
# BROWSER_CHANNEL=chrome   # use real Google Chrome (amd64). REQUIRED if you signed
                           # in with system Chrome. Leave unset on arm64 (bundled Chromium).

# --- Session lifecycle ------------------------------------------------------
MAX_DURATION_MIN=180       # hard safety cap per recording
# JOIN_TIMEOUT_SEC=120     # how long to wait in the lobby for admission
# EMPTY_THRESHOLD=1        # participant count (incl. bot) that counts as "empty"
# EMPTY_GRACE_SEC=90       # must stay empty this long before auto-leaving
# START_GRACE_SEC=300      # ignore "empty" for 5 min after joining (late lecturer)
# HEARTBEAT_INTERVAL_SEC=10

# --- Paths (inside the container) -------------------------------------------
# OUTPUT_DIR=/data/recordings
# WORK_DIR=/data/work
# LOG_DIR=/data/logs

# --- Post-processing --------------------------------------------------------
# POSTPROCESS=true         # EBU R128 loudness normalization (consistent volume)
# TRIM_SILENCE=true        # trim leading/trailing dead air
# TRANSCRIBE=false         # generate an .srt with Whisper (needs whisper installed)
# WHISPER_MODEL=base

# --- Upload -----------------------------------------------------------------
# UPLOAD_TARGET=local      # none | local | drive | youtube
# DELETE_AFTER_UPLOAD=false
#
# drive (via rclone): set the remote and mount rclone.conf (see docker-compose.yml)
# RCLONE_REMOTE=gdrive:ANCC/recordings
# RCLONE_CONFIG=/data/rclone.conf
#
# youtube (OAuth): obtain a refresh token once with `node scripts/google-auth.mjs`
# YOUTUBE_PRIVACY=unlisted
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REFRESH_TOKEN=

# --- Control API ------------------------------------------------------------
# PORT=8080
# API_TOKEN=               # if set, /record etc. require: Authorization: Bearer <token>
# MAX_CONCURRENT=2         # simultaneous recordings (each ~1 vCPU + ~1.5GB RAM)

# --- Scheduler --------------------------------------------------------------
# SCHEDULE_SOURCE=file     # file | gcal
# SCHEDULE_FILE=/data/schedule.json
# SCHEDULE_POLL_SEC=30
# GCAL_LOOKAHEAD_MIN=2     # join this many minutes before the event start
# GCAL_CALENDAR_ID=primary # reuses GOOGLE_CLIENT_ID/SECRET/REFRESH_TOKEN above

# --- Host user mapping (docker-compose) -------------------------------------
# Run the container as your host user so the login profile is readable and
# recordings are owned by you. Set these to the output of `id -u` / `id -g`
# if they aren't 1000.
# PUID=1000
# PGID=1000

# --- Misc -------------------------------------------------------------------
# TZ=Asia/Kolkata
# LOG_LEVEL=info
